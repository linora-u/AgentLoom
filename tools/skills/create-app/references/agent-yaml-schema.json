{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentloom.dev/schemas/agent-yaml.json",
  "title": "AgentLoom Agent YAML Configuration",
  "description": "Schema for AgentLoom Agent YAML files (Supervisor, Worker, or standalone Agent).",
  "type": "object",
  "required": ["name", "description", "workflow"],
  "additionalProperties": false,
  "definitions": {
    "skillEntry": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Skill 目录路径。相对路径基于项目根目录解析。"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "description": "可选平台标识，如 Claude。"
        },
        "invocation-control": {
          "type": "object",
          "properties": {
            "allow-model": {
              "oneOf": [
                { "type": "boolean" },
                { "type": "string", "enum": ["force-inject"] }
              ],
              "description": "Skill 可见性与加载策略：true/false/force-inject"
            },
            "allow-hook": {
              "type": "boolean",
              "description": "是否允许注册并触发该 Skill 的 Hook。"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Agent 唯一标识名称，建议小写+下划线"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Agent 功能描述，1-3 句话说明角色定位"
    },
    "model_type": {
      "type": "string",
      "description": "可选。模型类型引用 config/llm.yaml 的 model 节点；若省略则继承 model.default_model_type。可选值应从当前项目配置动态读取。",
      "examples": ["powerful", "fast", "summary", "common", "code_review"]
    },
    "tool_call_type": {
      "type": "string",
      "enum": ["code_act", "tool_call"],
      "default": "code_act",
      "description": "Agent 调用工具的方式。code_act=写 Python 代码调用；tool_call=结构化消息调用"
    },
    "workflow": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "单个工作流，推荐使用 YAML '|' 多行文本块。"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "顺序执行的多个工作流项。每一项都是独立的用户编写指令。"
        }
      ],
      "description": "Agent 工作流描述。支持单个字符串，或按顺序执行的非空 list[str]。支持 Markdown 和 Mermaid 流程图"
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "default": 80,
      "description": "Agent 最大执行步数。Supervisor 建议 80，Worker 建议 40"
    },
    "planning_interval": {
      "type": "integer",
      "minimum": 1,
      "description": "每隔 N 步触发一次规划。复杂 Worker 建议 3"
    },
    "tools": {
      "type": "array",
      "description": "Agent 可使用的工具列表",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "工具名称（预定义工具直接写名称，自定义工具需配合 module+function）"
          },
          "module": {
            "type": "string",
            "description": "自定义工具的 Python 模块路径（点分隔），如 applications.code_review.agent_tools.repo_context"
          },
          "function": {
            "type": "string",
            "description": "自定义工具的函数名，必须与 module 成对出现"
          },
          "description": {
            "type": "string",
            "description": "工具描述（注意：自定义工具的描述从函数 docstring 自动提取，此字段会被忽略）"
          }
        },
        "dependencies": {
          "module": ["function"],
          "function": ["module"]
        },
        "additionalProperties": false
      }
    },
    "worker_agents": {
      "type": "array",
      "description": "Worker Agent 列表（仅 Supervisor 使用）。每项必须用 path，禁止用 name",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Worker YAML 文件路径（相对于项目根目录）"
          }
        },
        "not": {
          "required": ["name"]
        },
        "additionalProperties": false
      }
    },
    "skills": {
      "description": "私有 Skill 配置。支持 string / dict / list 三种格式。",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "最简写法：skills: \"skills/agent-recall-with-files\""
        },
        {
          "$ref": "#/definitions/skillEntry"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/definitions/skillEntry"
              }
            ]
          }
        }
      ]
    },
    "agent_function_schema": {
      "type": "object",
      "description": "Worker 作为工具被 Supervisor 调用时的接口定义（仅 Worker 使用）",
      "required": ["description", "inputs", "output"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Worker 工具用途描述"
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "description": "输入参数定义。key 必须是合法 Python 标识符",
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_]*$": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "参数说明"
                },
                "required": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否必填"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "输出描述"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "execution_env": {
      "type": "object",
      "description": "执行环境配置",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["local", "docker", "e2b", "wasm"],
          "default": "local",
          "description": "执行环境类型"
        }
      },
      "additionalProperties": true
    },
    "system": {
      "type": "object",
      "description": "系统元数据覆盖（Overlay 白名单字段）"
    },
    "smart_summary": {
      "description": "上下文压缩策略覆盖（Overlay 白名单字段）"
    },
    "workspace": {
      "type": "object",
      "description": "工作目录和路径过滤覆盖（Overlay 白名单字段）"
    },
    "code_agent": {
      "type": "object",
      "description": "代码执行权限覆盖（Overlay 白名单字段）"
    },
    "prompt": {
      "description": "System Prompt 模板路径覆盖（Overlay 白名单字段）"
    }
  },
  "not": {
    "anyOf": [
      { "required": ["model"] },
      { "required": ["llm"] },
      { "required": ["langfuse"] }
    ]
  }
}
