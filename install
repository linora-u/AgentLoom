#!/usr/bin/env bash
set -euo pipefail

APP="AgentLoom"
MUTED='\033[0;2m'
RED='\033[0;31m'
NC='\033[0m'
NO_MODIFY_PATH=false
RUNTIME_PROFILE=""

usage() {
  cat <<'EOF'
AgentLoom source installer

Usage: ./install [options]

Options:
  --runtime pi|smol Select the Agent runtime (default: saved profile, or smol)
  --no-modify-path  Do not update the current shell configuration
  -h, --help        Show this help

Environment:
  AGENTLOOM_INSTALL_DIR  Custom installation root (environment: ROOT/venv)

Defaults: Python environment in the checkout's .venv; launchers and installation
records in the checkout's .agentloom.
Uses the uv-managed Python pinned in .python-version unless UV_PYTHON is set.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime)
      case "${2:-}" in
        pi|smol) RUNTIME_PROFILE=$2 ;;
        *) printf '%s\n' 'Error: --runtime requires pi or smol.' >&2; exit 2 ;;
      esac
      shift 2
      ;;
    --no-modify-path)
      NO_MODIFY_PATH=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf '%b\n' "${RED}Error: unknown option: $1${NC}" >&2
      usage >&2
      exit 2
      ;;
  esac
done

REPO_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
INSTALL_ROOT=${AGENTLOOM_INSTALL_DIR:-"$REPO_ROOT/.agentloom"}
if [[ -n "${AGENTLOOM_INSTALL_DIR:-}" ]]; then
  VENV_DIR="$INSTALL_ROOT/venv"
else
  VENV_DIR="$REPO_ROOT/.venv"
fi
# Updates pass the original environment explicitly, including the checkout layout.
VENV_DIR=${UV_PROJECT_ENVIRONMENT:-"$VENV_DIR"}
mkdir -p "$INSTALL_ROOT"
INSTALL_ROOT=$(cd -- "$INSTALL_ROOT" && pwd -P)
mkdir -p "$VENV_DIR"
VENV_DIR=$(cd -- "$VENV_DIR" && pwd -P)
if [[ -z "$RUNTIME_PROFILE" ]] && [[ -f "$INSTALL_ROOT/runtime-profile" ]]; then
  RUNTIME_PROFILE=$(cat "$INSTALL_ROOT/runtime-profile")
fi
RUNTIME_PROFILE=${RUNTIME_PROFILE:-smol}
case "$RUNTIME_PROFILE" in
  pi|smol) ;;
  *) printf '%s\n' 'Error: invalid saved runtime profile; select --runtime pi or smol.' >&2; exit 2 ;;
esac
BIN_DIR="$INSTALL_ROOT/bin"
mkdir -p "$BIN_DIR"

require_curl() {
  if ! command -v curl >/dev/null 2>&1; then
    printf '%b\n' "${RED}Error: curl is required to install missing build tools.${NC}" >&2
    exit 1
  fi
}

find_uv() {
  if command -v uv >/dev/null 2>&1; then
    command -v uv
  elif [[ -x "$HOME/.local/bin/uv" ]]; then
    printf '%s\n' "$HOME/.local/bin/uv"
  elif [[ -x "$HOME/.cargo/bin/uv" ]]; then
    printf '%s\n' "$HOME/.cargo/bin/uv"
  else
    return 1
  fi
}

if ! UV_BIN=$(find_uv); then
  require_curl
  printf '%b\n' "${MUTED}uv not found; installing it with Astral's official installer...${NC}"
  if ! curl -LsSf https://astral.sh/uv/install.sh | sh; then
    printf '%b\n' "${RED}Error: the official uv installer failed.${NC}" >&2
    exit 1
  fi
  if ! UV_BIN=$(find_uv); then
    printf '%b\n' "${RED}Error: uv was installed but its executable could not be found.${NC}" >&2
    exit 1
  fi
fi

printf '%b\n' "${MUTED}Creating the locked AgentLoom Python environment...${NC}"
RUNTIME_EXTRAS=(--extra "$RUNTIME_PROFILE")
if [[ "$RUNTIME_PROFILE" == smol ]]; then
  # Preserve the original source installer's complete code-tool environment.
  RUNTIME_EXTRAS+=(--extra code)
fi
SYNC_OPTIONS=(--locked)
if [[ -z "${UV_PYTHON:-}" ]]; then
  SYNC_OPTIONS+=(--managed-python --python "$(cat "$REPO_ROOT/.python-version")")
fi
if [[ "$VENV_DIR" == "$REPO_ROOT/.venv" ]]; then
  # This environment is shared with workspace applications and development tools.
  SYNC_OPTIONS+=(--inexact)
fi
UV_PROJECT_ENVIRONMENT="$VENV_DIR" "$UV_BIN" sync \
  "${SYNC_OPTIONS[@]}" \
  "${RUNTIME_EXTRAS[@]}" \
  --no-editable \
  --no-dev \
  --reinstall-package agentloom \
  --project "$REPO_ROOT"

if [[ "$RUNTIME_PROFILE" == pi ]]; then
  printf '%b\n' "${MUTED}Downloading the locked Pi SDK and building the bridge...${NC}"
  "$VENV_DIR/bin/python" -I -m agentloom runtime install pi
fi

printf '%s\n' "$REPO_ROOT" > "$INSTALL_ROOT/.source-root.$$.tmp"
mv -f "$INSTALL_ROOT/.source-root.$$.tmp" "$INSTALL_ROOT/source-root"
printf '%s\n' "$VENV_DIR" > "$INSTALL_ROOT/.python-environment.$$.tmp"
mv -f "$INSTALL_ROOT/.python-environment.$$.tmp" "$INSTALL_ROOT/python-environment"

WRAPPER_TMP="$BIN_DIR/.agentloom.$$.tmp"
cat > "$WRAPPER_TMP" <<'EOF'
#!/bin/sh
set -eu
install_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
venv_dir=$(sed -n '1p' "$install_root/python-environment")
if [ "${1:-}" = "update" ]; then
  shift
  source_root=$(sed -n '1p' "$install_root/source-root")
  if [ ! -x "$source_root/install" ]; then
    printf '%s\n' 'agentloom: the trusted source directory is unavailable; update from a checkout with ./install' >&2
    exit 1
  fi
  AGENTLOOM_INSTALL_DIR="$install_root" UV_PROJECT_ENVIRONMENT="$venv_dir" exec "$source_root/install" --no-modify-path "$@"
fi
exec "$venv_dir/bin/python" -I -m agentloom "$@"
EOF
chmod 755 "$WRAPPER_TMP"
mv -f "$WRAPPER_TMP" "$BIN_DIR/agentloom"
ln -sfn agentloom "$BIN_DIR/loom"
date +%s > "$INSTALL_ROOT/.installed-at.$$.tmp"
mv -f "$INSTALL_ROOT/.installed-at.$$.tmp" "$INSTALL_ROOT/installed-at"
printf '%s\n' "$RUNTIME_PROFILE" > "$INSTALL_ROOT/.runtime-profile.$$.tmp"
mv -f "$INSTALL_ROOT/.runtime-profile.$$.tmp" "$INSTALL_ROOT/runtime-profile"

add_to_path() {
  local config_file=$1
  local escaped_bin=${BIN_DIR//\\/\\\\}
  escaped_bin=${escaped_bin//\"/\\\"}
  local command="export PATH=\"$escaped_bin:\$PATH\""
  if grep -Fqx "$command" "$config_file"; then
    return
  fi
  {
    printf '\n# AgentLoom\n'
    printf '%s\n' "$command"
  } >> "$config_file"
  printf '%b\n' "${MUTED}Added AgentLoom to PATH in $config_file.${NC}"
}

if [[ "$NO_MODIFY_PATH" != true ]] && [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
  XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
  current_shell=$(basename "${SHELL:-sh}")
  config_file=""
  case "$current_shell" in
    fish)
      candidates=("$HOME/.config/fish/config.fish")
      ;;
    zsh)
      candidates=("${ZDOTDIR:-$HOME}/.zshrc" "${ZDOTDIR:-$HOME}/.zshenv" "$XDG_CONFIG_HOME/zsh/.zshrc")
      ;;
    bash)
      candidates=("$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile" "$XDG_CONFIG_HOME/bash/.bashrc")
      ;;
    *)
      candidates=("$HOME/.profile" "$HOME/.bashrc")
      ;;
  esac
  for candidate in "${candidates[@]}"; do
    if [[ -f "$candidate" && -w "$candidate" ]]; then
      config_file=$candidate
      break
    fi
  done
  if [[ -n "$config_file" ]]; then
    if [[ "$current_shell" == fish ]]; then
      fish_command="fish_add_path \"$BIN_DIR\""
      if ! grep -Fqx "$fish_command" "$config_file"; then
        printf '\n# AgentLoom\n%s\n' "$fish_command" >> "$config_file"
      fi
    else
      add_to_path "$config_file"
    fi
  else
    printf '%b\n' "${MUTED}No writable shell config found. Add this directory to PATH:${NC}"
    printf '  export PATH="%s:%s"\n' "$BIN_DIR" '$PATH'
  fi
fi

printf '\n%s installed successfully.\n' "$APP"
printf 'Python environment: %s\n' "$VENV_DIR"
printf 'Run now: %s/agentloom --help\n' "$BIN_DIR"
printf 'Run schedules: %s/agentloom schedules --project /path/to/project serve\n' "$BIN_DIR"
printf 'After opening a new shell: agentloom --help\n'
