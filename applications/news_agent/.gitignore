__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
# Keep generated data, caches and other local files ignored.
/data/*

# ETF universe, evaluation prices and dated exposure inputs.
!/data/etf_universe.yaml
!/data/etf_dk_merge/
/data/etf_dk_merge/**
!/data/etf_dk_merge/ts_code=*/
!/data/etf_dk_merge/ts_code=*/data.parquet
!/data/etf_dk_merge/copy_manifest.json
!/data/etf_exposure/
/data/etf_exposure/*
!/data/etf_exposure/??????.SH.json
!/data/etf_exposure/??????.SZ.json
!/data/etf_exposure/manifest.json
!/data/etf_exposure/stock_name_changes.json
!/data/etf_exposure/stock_name_changes_manifest.json
!/data/etf_exposure/stock_names_current_*.json
!/data/etf_exposure/official_reports/
/data/etf_exposure/official_reports/*
!/data/etf_exposure/official_reports/*.json
!/data/etf_exposure/official_reports/*.pdf

!/data/news/
/data/news/*

# Original news records and complete source documents.
!/data/news/raw/
/data/news/raw/**
!/data/news/raw/**/
!/data/news/raw/**/data.parquet
!/data/news/documents/
/data/news/documents/**
!/data/news/documents/央行货币政策报告/
!/data/news/documents/央行货币政策报告/date=*/
!/data/news/documents/央行货币政策报告/date=*/*.pdf
!/data/news/documents/央行货币政策报告/date=*/*.txt
!/data/news/documents/央行货币政策报告/date=*/*.json

# Source inventory and hashes are part of the reproducible input snapshot.
!/data/news/_manifest/
/data/news/_manifest/*
!/data/news/_manifest/download_summary.json
!/data/news/_manifest/copy_manifest*.json

# Generated evaluation datasets and runtime outputs stay local.
/evaluation/data/
/evaluation/prehistory/
/output/
